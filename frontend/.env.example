# Soroban RPC endpoint. Testnet by default.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase must match the RPC endpoint's network.
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Fill these in after running scripts/deploy.sh (see docs/DEPLOYMENT.md)
VITE_BOUNTY_CONTRACT_ID=
VITE_REPUTATION_CONTRACT_ID=
