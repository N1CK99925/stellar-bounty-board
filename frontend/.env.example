# ============================================================
# Stellar Bounty Board — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env — it is in .gitignore.
# Set these as Environment Variables in Vercel/Netlify when deploying.
# ============================================================

# Soroban RPC endpoint. Testnet by default.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase — must match the RPC endpoint network.
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract IDs for the verified Stellar testnet deployment.
# Leaving these empty enables "Demo mode" (sample data, clearly labeled).
VITE_BOUNTY_CONTRACT_ID=CDILINO5W2FYL6IDIKUICS7OGYXQWMMUIA2GO4FRI2I4YV5UZQ5FFJYM
VITE_REPUTATION_CONTRACT_ID=CDG4TDKVA3L64BNNTF5P754WCDIAYHOROY4GEAISNXWRSOQTEBBLPFPJ
